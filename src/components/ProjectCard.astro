---
// Project summary card used on the home page and the projects list.
// `data-tech` lets the TechFilter island show or hide the card without re-rendering it.
import TechTags from './TechTags.astro';
import { slugOf, type Project } from '../lib/content';
import { formatPeriod } from '../i18n/format';
import { localePath } from '../i18n/paths';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  project: Project;
}

const { lang, project } = Astro.props;
const { title, summary, startDate, endDate, tech, outcomes, confidential } = project.data;
---

<article
  data-project-card
  data-tech={JSON.stringify(tech)}
  class="relative flex flex-col gap-3 rounded-xl border border-zinc-200 p-5 transition hover:border-zinc-400 dark:border-zinc-800 dark:hover:border-zinc-600"
>
  <div class="flex items-baseline justify-between gap-3">
    <h3 class="font-semibold text-zinc-900 dark:text-zinc-100">
      <!-- The ::after overlay makes the whole card clickable. -->
      <a href={localePath(lang, 'projects', slugOf(project))} class="after:absolute after:inset-0">{title}</a>
    </h3>
    <span class="shrink-0 text-xs text-zinc-500">{formatPeriod(lang, startDate, endDate)}</span>
  </div>
  {
    confidential && (
      <span class="w-fit rounded bg-amber-100 px-2 py-0.5 text-xs text-amber-800 dark:bg-amber-900/40 dark:text-amber-300">
        {t(lang, 'project.confidential')}
      </span>
    )
  }
  <p class="text-sm text-zinc-600 dark:text-zinc-400">{summary}</p>
  <ul class="list-inside list-disc text-sm text-zinc-700 dark:text-zinc-300">
    {outcomes.map((outcome) => <li>{outcome}</li>)}
  </ul>
  <div class="mt-auto">
    <TechTags tech={tech} />
  </div>
</article>
